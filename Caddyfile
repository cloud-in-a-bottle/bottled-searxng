{
	auto_https off
}

:3000 {
	# Refuse to be framed. SearXNG only sends the headers listed in its
	# server.default_http_headers setting, whose upstream default covers
	# nosniff and Referrer-Policy but not framing, so a public instance can
	# otherwise be embedded in any page and its search box used for
	# phishing. The ? prefix sets each header only when the response does
	# not already carry it, so a future SearXNG version that sends its own
	# (likely stronger) value still wins.
	header {
		?X-Frame-Options DENY
		?Content-Security-Policy "frame-ancestors 'none'"
	}

	reverse_proxy localhost:8080 {
		# Rewrite the Host header from X-Forwarded-Host so that SearXNG
		# sees the correct origin. The OpenHost router strips Host and
		# puts the real value in X-Forwarded-Host.
		header_up Host {header.X-Forwarded-Host}

		# Briefly hold and retry the dial so requests that land before
		# SearXNG (granian) has bound :8080 during container startup are
		# bridged instead of returning an immediate 502 (e.g. the OpenHost
		# router's wait-for-ready probe). Bounded to 15s: granian is the
		# container's main process, so a steady-state crash exits the
		# container rather than lingering here, and a genuinely-down
		# upstream still surfaces as an error after the window.
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}
